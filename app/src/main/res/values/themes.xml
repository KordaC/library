<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.AppLibrary" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/library_primary</item>
        <item name="colorOnPrimary">@color/library_on_primary</item>
        <item name="colorPrimaryContainer">@color/library_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/library_on_primary_container</item>

        <item name="colorSecondary">@color/library_secondary</item>
        <item name="colorOnSecondary">@color/library_on_secondary</item>
        <item name="colorSecondaryContainer">@color/library_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/library_on_secondary_container</item>

        <item name="colorTertiary">@color/library_tertiary</item>
        <item name="colorOnTertiary">@color/library_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/library_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/library_on_tertiary_container</item>

        <item name="android:colorBackground">@color/library_background</item>
        <item name="colorOnBackground">@color/library_on_background</item>
        <item name="colorSurface">@color/library_surface</item>
        <item name="colorOnSurface">@color/library_on_surface</item>
        <item name="colorSurfaceVariant">@color/library_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/library_on_surface_variant</item>
        <item name="colorOutline">@color/library_outline</item>

        <item name="colorError">@color/library_error</item>
        <item name="colorOnError">@color/library_on_error</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/library_surface</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>

        <item name="materialCardViewStyle">@style/Widget.AppLibrary.Card</item>
        <item name="materialButtonStyle">@style/Widget.AppLibrary.Button</item>
        <item name="textInputStyle">@style/Widget.AppLibrary.TextInputLayout</item>
        <item name="bottomNavigationStyle">@style/Widget.AppLibrary.BottomNav</item>
    </style>

    <style name="Theme.AppLibrary" parent="Base.Theme.AppLibrary" />

    <style name="Theme.AppLibrary.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/library_primary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_logo_library</item>
        <item name="postSplashScreenTheme">@style/Theme.AppLibrary</item>
    </style>

    <style name="Theme.AppLibrary.QrFullscreen" parent="Theme.AppLibrary">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>

</resources>
